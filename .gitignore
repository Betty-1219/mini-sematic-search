# =============================================================
#  .gitignore — Mini Semantic Search System
#  Files and folders that should NOT be uploaded to GitHub
# =============================================================

# --- Python virtual environment ---
# This folder holds installed packages. Others install
# their own using requirements.txt, so don't commit it.
venv/
env/
.venv/
.env/

# --- Python compiled files (auto-generated, not needed) ---
__pycache__/
*.py[cod]
*$py.class
*.pyo

# --- Jupyter Notebook checkpoints ---
# Auto-saved temporary files created by Jupyter
.ipynb_checkpoints/

# --- ChromaDB database files ---
# This folder is large and generated automatically on first run.
# Each person builds their own local copy.
data/chroma_db/

# --- Environment variable files (may contain secrets) ---
.env
*.env

# --- macOS system files ---
.DS_Store

# --- Windows system files ---
Thumbs.db
desktop.ini

# --- IDE settings ---
.vscode/settings.json
.idea/

# --- Distribution and packaging ---
dist/
build/
*.egg-info/

# --- Test cache ---
.pytest_cache/
.coverage
htmlcov/

# --- Log files ---
*.log
